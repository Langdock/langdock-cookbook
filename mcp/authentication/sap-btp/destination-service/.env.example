# Required when running locally (automatically populated from VCAP_SERVICES on SAP BTP Cloud Foundry)
XSUAA_URL=https://your-subdomain.authentication.eu10.hana.ondemand.com
XSUAA_CLIENT_ID=sb-mcp-sap-btp-destination!t12345
XSUAA_CLIENT_SECRET=your-xsuaa-client-secret

DESTINATION_URI=https://destination-configuration.cfapps.eu10.hana.ondemand.com
DESTINATION_AUTH_URL=https://your-subdomain.authentication.eu10.hana.ondemand.com
DESTINATION_CLIENT_ID=sb-clone!b12345|destination-xsappname!b62
DESTINATION_CLIENT_SECRET=your-destination-client-secret

# Optional: Default destination name if none is passed to the tool
# DEFAULT_DESTINATION_NAME=ServiceNowPDI

# Optional: Comma-separated allowlist of BTP destinations this MCP server may resolve (defaults to DEFAULT_DESTINATION_NAME)
# ALLOWED_DESTINATIONS=ServiceNowPDI

# Optional: Public URL of this MCP server (defaults to https://<application_uris[0]> on BTP or http://localhost:3333 locally)
# SERVER_URL=http://localhost:3333

# Optional: Port (defaults to 3333 locally; set automatically by Cloud Foundry)
# PORT=3333
