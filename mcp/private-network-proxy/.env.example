# Public proxy port (this is the URL you register in Langdock)
PORT=3000

# Dummy private MCP — loopback only. Point PRIVATE_MCP_URL at your real
# internal MCP in production.
PRIVATE_MCP_PORT=3001
PRIVATE_MCP_URL=http://127.0.0.1:3001

# Comma-separated IPv4 addresses or CIDRs. Empty allowlist denies everyone.
# Langdock cloud egress: https://docs.langdock.com/en/admin/security/static-ip-configuration
ALLOWED_IPS=4.185.103.44,127.0.0.1
