# Workspace API key with ASSISTANT_API and KNOWLEDGE_FOLDER_API
LANGDOCK_API_KEY=

# Agent UUID shared with that API key
LANGDOCK_AGENT_ID=

# Cloud default. Dedicated: https://<your-domain>/api/public
# LANGDOCK_API_BASE=https://api.langdock.com

# CSP frame-ancestors. Default is *
# ALLOWED_ORIGINS=*

# WIDGET_TITLE=Assistant
# PORT=3333
